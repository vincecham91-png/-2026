rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // 辅助函数
    // ========================================

    // 检查请求者是否为已登入教师
    function isTeacher() {
      return request.auth != null
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    // 检查请求者是否为管理员
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == 'admin';
    }

    // ========================================
    // students Collection
    // 注意：學生使用自定義登入（非 Firebase Auth），
    // 因此安全性由前端應用層控制。
    // 生產環境建議為學生實作 Firebase Auth。
    // ========================================
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ========================================
    // works Collection
    // ========================================
    match /works/{workId} {
      allow read, create, update: if true;
      allow delete: if isTeacher() || isAdmin();
    }

    // ========================================
    // classes Collection
    // ========================================
    match /classes/{classId} {
      allow read: if true;
      allow write: if true;
    }

    // ========================================
    // teachers Collection
    // ========================================
    match /teachers/{teacherId} {
      allow read: if request.auth != null
        && (request.auth.uid == teacherId || isAdmin());
      allow write: if isAdmin();
    }

    // ========================================
    // settings Collection
    // ========================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================
    // logs Collection
    // ========================================
    match /logs/{logId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ========================================
    // announcements Collection
    // ========================================
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    // ========================================
    // statistics Collection
    // ========================================
    match /statistics/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
